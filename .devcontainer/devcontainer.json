{
    "name": ".NET in Codespaces",
    "image": "mcr.microsoft.com/dotnet/sdk:10.0",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {},
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers/features/powershell:1": {
            "version": "latest"
        },
        "ghcr.io/azure/azure-dev/azd:0": {},
        "ghcr.io/devcontainers/features/common-utils:2": {},
        "ghcr.io/devcontainers/features/dotnet:2": {},
        "ghcr.io/devcontainers/features/powershell:2": {},
        "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {},
        "ghcr.io/stuartleeks/dev-container-features/add-host:1": {},
        "ghcr.io/flexwie/devcontainer-features/op:1": {},
        "ghcr.io/nordcominc/devcontainer-features/android-sdk:1": {},
        "ghcr.io/casl0/devcontainer-features/android-sdk:1": {},
        "ghcr.io/georgofenbeck/features/ammonite-homebrew:1": {},
        "ghcr.io/georgofenbeck/features/ammonite-linuxbinary:1": {},
        "ghcr.io/skriptfabrik/devcontainer-features/mailpit:1": {},
        "ghcr.io/nikiforovall/devcontainer-features/dotnet-csharpier:1": {},
        "ghcr.io/devcontainer-community/devcontainer-features/apt-build-essential:1": {},
        "ghcr.io/dotnet/aspire-devcontainer-feature/dotnetaspire:1": {},
        "ghcr.io/daniellindemann/dev-container-features/dotnet-usersecrets-persistence:0": {},
        "ghcr.io/rails/devcontainer/features/activestorage:1": {},
        "ghcr.io/devcontainer-config/features/dot-config:4": {},
        "ghcr.io/Evit15/devcontainer-features/adb-fastboot:1": {},
        "ghcr.io/wcgomes/devcontainer-features/agents-workspace:0": {},
        "ghcr.io/postfinance/devcontainer-features/dotnet:1": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.vscode-node-azure-pack",
                "GitHub.copilot",
                "GitHub.vscode-github-actions",
                "ms-dotnettools.csdevkit"
            ]
        }
    },
    "forwardPorts": [
        8080,
        8081
    ],
    "postCreateCommand": "dotnet new install Aspire.ProjectTemplates && cd ./SampleApp && dotnet restore",
    "hostRequirements": {
        "memory": "8gb",
        "cpus": 4
    },
    "remoteEnv": {
        "DOTNET_MULTILEVEL_LOOKUP": "0",
        "TARGET": "net10.0"
    },
    "portsAttributes": {
        "8080": {
            "label": "Weather API",
            "onAutoForward": "notify"
        },
        "8081": {
            "label": "Weather Front End",
            "onAutoForward": "notify"
        }
    }
}
